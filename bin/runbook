#!/usr/bin/python3
"""Runbook engine: stores the user's scripts and drives a private tmux server.

Every subcommand prints one JSON document on stdout. Errors of our own print
{"error": "..."} and exit 1. Data from the panel arrives as one JSON line on
stdin; only ids and numbers travel as arguments.
"""
import datetime
import hashlib
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
import time

USAGE = "Usage: runbook <command> [id] [--cols N --rows N]"


class RunbookError(Exception):
    """An error we report to the panel as {"error": message}."""


# ---------------------------------------------------------------- store

DEFAULT_VIEW = {"width": 960, "height": 540}
ID_RE = re.compile(r"^[0-9a-f]{32}$")
NAME_MAX, COMMAND_MAX, HELP_MAX = 64, 4096, 4096
VIEW_WIDTH, VIEW_HEIGHT = (600, 4000), (360, 3000)
SCHEDULE_SECONDS = (60, 604800)  # 1 minuto a 7 días
# Forma que produce la UI y acepta systemd: "[<dow-set> ]*-*-* HH:MM:SS", donde
# <dow-set> es uno o más días unidos por "," o ".." (p.ej. "Mon,Wed,Fri" o "Mon..Wed,Fri").
_WEEKDAY = r"(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)"
_WEEKDAY_SET = _WEEKDAY + r"(?:(?:,|\.\.)" + _WEEKDAY + r")*"
_ONCALENDAR_RE = re.compile(r"^(?:" + _WEEKDAY_SET + r" )?\*-\*-\* \d{2}:\d{2}:\d{2}\Z")


def library_path(environ):
    base = environ.get("XDG_CONFIG_HOME") or os.path.join(
        environ.get("HOME") or os.path.expanduser("~"), ".config")
    return os.path.join(base, "runbook", "scripts.json")


def empty_library():
    return {"version": 1, "view": dict(DEFAULT_VIEW), "scripts": []}


def _has_control_chars(text):
    return any(ord(ch) < 32 or ord(ch) == 127 for ch in text)


def _text(fields, key, maximum, minimum, label):
    value = fields.get(key, "")
    if value is None:
        value = ""
    if not isinstance(value, str):
        raise RunbookError(f"{label} must be text")
    value = value.strip()
    if len(value) < minimum:
        raise RunbookError(f"{label} must be {minimum}-{maximum} characters")
    if len(value) > maximum:
        if minimum == 0:
            raise RunbookError(f"{label} must be at most {maximum} characters")
        raise RunbookError(f"{label} must be {minimum}-{maximum} characters")
    return value


def validate_script(fields):
    if not isinstance(fields, dict):
        raise RunbookError("Script must be a JSON object")
    name = _text(fields, "name", NAME_MAX, 1, "Name")
    if _has_control_chars(name):
        raise RunbookError("Name must not contain control characters")
    command = _text(fields, "command", COMMAND_MAX, 1, "Command")
    help_text = _text(fields, "help", HELP_MAX, 0, "Help")
    result = {"name": name, "command": command, "help": help_text}
    if "schedule" in fields:
        result["schedule"] = validate_schedule(fields.get("schedule"))
    return result


def _bounded_int(value, bounds, label):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise RunbookError(f"{label} must be a number")
    number = int(value)
    if not bounds[0] <= number <= bounds[1]:
        raise RunbookError(f"{label} must be between {bounds[0]} and {bounds[1]}")
    return number


def validate_view(view):
    if not isinstance(view, dict):
        raise RunbookError("View must be a JSON object")
    return {"width": _bounded_int(view.get("width"), VIEW_WIDTH, "Width"),
            "height": _bounded_int(view.get("height"), VIEW_HEIGHT, "Height")}


def validate_schedule(value):
    if value is None:
        return None
    if not isinstance(value, dict):
        raise RunbookError("Schedule must be a JSON object or null")
    kind = value.get("kind")
    if kind == "interval":
        seconds = value.get("seconds")
        if isinstance(seconds, bool) or not isinstance(seconds, int):
            raise RunbookError("Interval seconds must be an integer")
        if not SCHEDULE_SECONDS[0] <= seconds <= SCHEDULE_SECONDS[1]:
            raise RunbookError("Interval must be between 1 minute and 7 days")
        return {"kind": "interval", "seconds": seconds}
    if kind == "calendar":
        expr = value.get("oncalendar")
        if not isinstance(expr, str) or not _ONCALENDAR_RE.match(expr):
            raise RunbookError("Not a valid schedule")
        return {"kind": "calendar", "oncalendar": expr}
    raise RunbookError("Unknown schedule kind")


def _normalise(raw):
    library = empty_library()
    if not isinstance(raw, dict):
        return library
    try:
        library["view"] = validate_view(raw.get("view"))
    except RunbookError:
        pass
    scripts = raw.get("scripts")
    if scripts is None:
        scripts = []
    elif not isinstance(scripts, list):
        raise RunbookError("scripts.json: scripts must be a list")
    seen_ids = set()
    for index, item in enumerate(scripts, start=1):
        if not isinstance(item, dict):
            raise RunbookError(f"scripts.json: script {index} is not an object")
        name = item.get("name")
        label = name if isinstance(name, str) else str(name)
        script_id = item.get("id")
        if not isinstance(script_id, str) or not ID_RE.match(script_id):
            raise RunbookError(f'scripts.json: script {index} ("{label}") has an invalid id')
        if script_id in seen_ids:
            raise RunbookError(f"scripts.json: duplicate id {script_id}")
        seen_ids.add(script_id)
        try:
            script = validate_script(item)
        except RunbookError as exc:
            raise RunbookError(f'scripts.json: script {index} ("{label}"): {exc}') from exc
        script["id"] = script_id
        library["scripts"].append(script)
    return library


def load_library(path):
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        return empty_library()
    except (OSError, UnicodeDecodeError) as exc:
        raise RunbookError(f"Cannot read scripts.json: {exc}")
    except json.JSONDecodeError:
        raise RunbookError("scripts.json is not valid JSON")
    return _normalise(raw)


def _atomic_write(path, text):
    """Write text to path via a temp file in the same dir, then rename in
    place: readers never see a partial file, and cleanup runs on failure."""
    directory = os.path.dirname(path)
    fd, tmp_path = tempfile.mkstemp(prefix=".tmp-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, path)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def save_library(path, library):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    _atomic_write(path, json.dumps(library, ensure_ascii=False, indent=2) + "\n")


def new_id():
    return secrets.token_hex(16)


def find_script(library, script_id):
    for script in library["scripts"]:
        if script["id"] == script_id:
            return script
    return None


def _check_unique(library, name, skip_id=None):
    for script in library["scripts"]:
        if script["id"] != skip_id and script["name"].casefold() == name.casefold():
            raise RunbookError(f"A script named \"{name}\" already exists")


def add_script(library, fields):
    script = validate_script(fields)
    _check_unique(library, script["name"])
    script["id"] = new_id()
    library["scripts"].append(script)
    return script


def update_script(library, script_id, fields):
    current = find_script(library, script_id)
    if current is None:
        raise RunbookError("No such script")
    script = validate_script(fields)
    _check_unique(library, script["name"], skip_id=script_id)
    current.update(script)
    return current


def remove_script(library, script_id):
    current = find_script(library, script_id)
    if current is None:
        raise RunbookError("No such script")
    library["scripts"].remove(current)
    return current


def set_view(library, view):
    library["view"] = validate_view(view)
    return library["view"]


# ---------------------------------------------------------------- config

def config_file_path(environ):
    base = environ.get("XDG_CONFIG_HOME") or os.path.join(
        environ.get("HOME") or os.path.expanduser("~"), ".config")
    return os.path.join(base, "runbook", "config.json")


def default_config():
    return {"version": 1, "readily": {"enabled": False}}


def _repair_config(raw):
    """Coerce whatever was read or merged into the exact expected shape.
    Config is app state, not user-authored content: never raise, repair."""
    config = default_config()
    if isinstance(raw, dict):
        readily = raw.get("readily")
        if isinstance(readily, dict) and isinstance(readily.get("enabled"), bool):
            config["readily"]["enabled"] = readily["enabled"]
    return config


def load_config(environ):
    path = config_file_path(environ)
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (FileNotFoundError, OSError, UnicodeDecodeError, json.JSONDecodeError):
        return default_config()
    return _repair_config(raw)


def save_config(environ, config):
    path = config_file_path(environ)
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    _atomic_write(path, json.dumps(config, ensure_ascii=False, indent=2) + "\n")
    return config


# ------------------------------------------------------- readily schedules

def readily_schedules_path(environ):
    """Side-store for schedules on Readily items: those synthetic ids never
    live in scripts.json (that file is native-scripts-only), so their
    schedules are kept here, keyed by id. Mirrors config_file_path."""
    base = environ.get("XDG_CONFIG_HOME") or os.path.join(
        environ.get("HOME") or os.path.expanduser("~"), ".config")
    return os.path.join(base, "runbook", "readily-schedules.json")


def load_readily_schedules(environ):
    """The side-store is a user-editable file: repair, never raise. A key
    that isn't a valid 32-hex id is dropped (it would otherwise reach
    _unit_base(sid) -> a path-traversal unit write); a value that doesn't
    validate as a schedule is dropped too (it would otherwise reach
    render_timer and raise an uncaught KeyError). validate_schedule returns
    fresh dicts and, for a calendar schedule, only checks the regex (no
    systemd-analyze call), so this stays a pure, run-less read."""
    path = readily_schedules_path(environ)
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (FileNotFoundError, OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {}
    if not isinstance(raw, dict):
        return {}
    cleaned = {}
    for k, v in raw.items():
        if not (isinstance(k, str) and ID_RE.match(k)):
            continue
        try:
            sv = validate_schedule(v)
        except RunbookError:
            continue
        if sv is None:  # a null/"no schedule" entry has no business persisting
            continue
        cleaned[k] = sv
    return cleaned


def save_readily_schedules(environ, data):
    path = readily_schedules_path(environ)
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    _atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    return data


# ----------------------------------------------------------------- tmux

NO_SESSION_MESSAGE = "No session for this script"
NO_SESSION_MARKERS = ("no server running", "can't find", "no current target", "session not found",
                      "error connecting to", "server exited unexpectedly")
COLS_RANGE, ROWS_RANGE = (20, 500), (5, 200)
PROMPT_RE = re.compile(r"(password|contraseña)[^:]*:\s*$", re.IGNORECASE)
STATE_FORMAT = "#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}\t#{pane_pid}"
LIST_FORMAT = "#{session_name}\t#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}"
LAUNCHER = 'export PATH="$RUNBOOK_PATH"; exec bash -c "$RUNBOOK_COMMAND"'


class NoSession(RunbookError):
    def __init__(self):
        super().__init__(NO_SESSION_MESSAGE)


class Tmux:
    """Every tmux call: fixed socket and config, bounded time, argv only."""

    def __init__(self, socket, conf, run=subprocess.run, timeout=5.0):
        self.socket = socket
        self.conf = conf
        self.run = run
        self.timeout = timeout

    def call(self, *args):
        argv = ["tmux", "-L", self.socket, "-f", self.conf, *args]
        try:
            proc = self.run(argv, capture_output=True, text=True, timeout=self.timeout, check=False)
        except subprocess.TimeoutExpired:
            raise RunbookError(f"tmux did not answer within {self.timeout:g} seconds")
        except OSError as exc:
            raise RunbookError(f"Cannot run tmux: {exc}")
        return proc.returncode, proc.stdout or "", proc.stderr or ""


def _missing(stderr):
    text = stderr.lower()
    return any(marker in text for marker in NO_SESSION_MARKERS)


def _fail(stderr):
    return RunbookError("tmux: " + (stderr.strip() or "unknown error"))


def check_id(script_id):
    if not isinstance(script_id, str) or not ID_RE.match(script_id):
        raise RunbookError("Invalid script id")
    return script_id


def clamp_size(cols, rows):
    return (min(max(int(cols), COLS_RANGE[0]), COLS_RANGE[1]),
            min(max(int(rows), ROWS_RANGE[0]), ROWS_RANGE[1]))


def path_with_local_bin(environ):
    home = environ.get("HOME") or os.path.expanduser("~")
    local = os.path.join(home, ".local", "bin")
    parts = [p for p in environ.get("PATH", "").split(":") if p]
    if local not in parts:
        parts.insert(0, local)
    return ":".join(parts)


def _exit_code(dead, status, sig):
    if not dead:
        return None
    if status.strip():
        return int(status)
    if sig.strip():
        return 128 + int(sig)
    return None


def list_sessions(tmux):
    code, out, err = tmux.call("list-sessions", "-F", LIST_FORMAT)
    if code != 0:
        if _missing(err):
            return {}
        raise _fail(err)
    sessions = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 4 or not ID_RE.match(parts[0]):
            continue
        dead = parts[1] == "1"
        sessions[parts[0]] = {"dead": dead, "exit": _exit_code(dead, parts[2], parts[3])}
    return sessions


def session_state(tmux, script_id):
    code, out, err = tmux.call("display", "-p", "-t", script_id, STATE_FORMAT)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)
    parts = out.strip("\n").split("\t")
    if len(parts) != 4 or parts[3].strip() == "":
        raise NoSession()
    dead = parts[0] == "1"
    return {"dead": dead, "exit": _exit_code(dead, parts[1], parts[2]), "pid": int(parts[3])}


def start_session(tmux, script_id, command, cols, rows, environ):
    home = environ.get("HOME") or os.path.expanduser("~")
    code, _, err = tmux.call(
        "new-session", "-d", "-s", script_id, "-x", str(cols), "-y", str(rows), "-c", home,
        "-e", "RUNBOOK_COMMAND=" + command,
        "-e", "RUNBOOK_PATH=" + path_with_local_bin(environ),
        "--", LAUNCHER)
    if code != 0:
        raise _fail(err)


def trim_trailing_blank(text):
    lines = text.split("\n")
    while lines and lines[-1].strip() == "":
        lines.pop()
    return "\n".join(lines)


def capture(tmux, script_id):
    code, out, err = tmux.call("capture-pane", "-p", "-t", script_id)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)
    return trim_trailing_blank(out)


def detect_prompt(text):
    for line in reversed(text.split("\n")):
        if line.strip():
            return "password" if PROMPT_RE.search(line) else None
    return None


def _checked(tmux, *args):
    code, _, err = tmux.call(*args)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)


def send_line(tmux, script_id, text):
    session_state(tmux, script_id)
    if text != "":
        _checked(tmux, "send-keys", "-t", script_id, "-l", "--", text)
    _checked(tmux, "send-keys", "-t", script_id, "Enter")


def resize_session(tmux, script_id, cols, rows):
    session_state(tmux, script_id)
    _checked(tmux, "resize-window", "-t", script_id, "-x", str(cols), "-y", str(rows))


def kill_session(tmux, script_id):
    tmux.call("kill-session", "-t", script_id)


# ----------------------------------------------------------------- stop


def _wait_dead(tmux, script_id, deadline, sleep, clock, poll):
    """Poll the pane until it is dead or the deadline passes. Returns the state."""
    while True:
        state = session_state(tmux, script_id)
        if state["dead"] or clock() >= deadline:
            return state
        sleep(poll)


def _signal_group(kill, pid, sig):
    try:
        kill(-pid, sig)
    except OSError:
        pass


def stop_session(tmux, script_id, *, kill=os.kill, sleep=time.sleep, clock=time.monotonic,
                 grace=2.0, poll=0.1):
    """Interrupt the command but keep its screen: C-c, then SIGTERM and SIGKILL
    to the pane's process group (tmux starts the command as group leader, so
    the pgid equals pane_pid)."""
    state = session_state(tmux, script_id)
    if state["dead"]:
        return {"dead": True, "exit": state["exit"]}
    _checked(tmux, "send-keys", "-t", script_id, "C-c")
    state = _wait_dead(tmux, script_id, clock() + grace, sleep, clock, poll)
    if not state["dead"]:
        _signal_group(kill, state["pid"], signal.SIGTERM)
        state = _wait_dead(tmux, script_id, clock() + grace, sleep, clock, poll)
    if not state["dead"]:
        _signal_group(kill, state["pid"], signal.SIGKILL)
        state = _wait_dead(tmux, script_id, clock() + poll * 4, sleep, clock, poll)
    return {"dead": state["dead"], "exit": state["exit"]}


# ------------------------------------------------------------------ cli

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_COLS, DEFAULT_ROWS = 80, 24


def build_tmux(environ, run):
    socket = environ.get("RUNBOOK_TMUX_SOCKET") or "runbook"
    conf = environ.get("RUNBOOK_TMUX_CONF") or os.path.join(PLUGIN_DIR, "tmux.conf")
    return Tmux(socket, conf, run=run)


# ------------------------------------------------------------------ readily

READILY_PLUGIN_ID = "io.github.ferc10110.readily"


def readily_bin(environ):
    """Locate the readily binary: env override, sibling plugin, then PATH."""
    override = environ.get("RUNBOOK_READILY_BIN")
    if override and os.path.isfile(override):
        return override
    sibling = os.path.join(os.path.dirname(PLUGIN_DIR), READILY_PLUGIN_ID, "bin", "readily")
    if os.path.isfile(sibling):
        return sibling
    return shutil.which("readily", path=environ.get("PATH"))


def _readily_id(section, title):
    """Stable synthetic id for a Readily item, keyed on its note (section name)
    and title (the ## heading). Stable across command-body edits; changes only
    if the item is renamed or moved to another note in Obsidian.

    The namespace is b"readily\0<section>\0<title>". For the "commands" note
    this equals the original b"readily\0commands\0<title>" formula, so items
    that were already scheduled keep their ids and never orphan."""
    digest = hashlib.sha256(
        b"readily\0" + section.encode("utf-8") + b"\0" + title.encode("utf-8")).hexdigest()
    return digest[:32]


def _readily_empty(warning):
    return {"scripts": [], "skipped": 0, "warning": warning, "ok": False}


def read_readily_commands(environ, run):
    """Read the #runbook-tagged items from EVERY Readily note (not only the
    "commands" note) by shelling out to the readily binary (argv only, no
    shell). An item is included when it -- or its note's frontmatter -- carries
    the #runbook tag; `readily list --tag runbook` does that filtering. Never
    raises: any failure -- binary missing, Readily unconfigured, the CLI calls
    failing, or an unparseable response -- degrades to an empty result with a
    warning; the dispatch layer decides how to surface it.

    The result's "ok" flag distinguishes that degradation (ok: False, a
    transient/config problem: callers must NOT treat its empty "scripts"
    as meaning "no Readily commands exist") from a genuine successful read
    (ok: True, even when it finds zero #runbook items -- that is a real
    answer, safe to treat as such)."""
    try:
        binary = readily_bin(environ)
        if not binary:
            return _readily_empty("Readily not found")

        where = run([binary, "where", "--json"], capture_output=True, text=True)
        if where.returncode != 0:
            return _readily_empty("Readily is not available")
        try:
            where_data = json.loads(where.stdout or "")
        except ValueError:
            return _readily_empty("Readily returned an unexpected response")
        if not isinstance(where_data, dict) or not where_data.get("exists"):
            return _readily_empty("Readily has no folder configured")

        listing = run([binary, "list", "--tag", "runbook", "--json"],
                      capture_output=True, text=True)
        if listing.returncode != 0:
            return _readily_empty("Readily list failed")
        try:
            listing_data = json.loads(listing.stdout or "")
        except ValueError:
            return _readily_empty("Readily returned an unexpected response")
        if not isinstance(listing_data, dict):
            return _readily_empty("Readily returned an unexpected response")

        sections = listing_data.get("sections")
        if not isinstance(sections, list):
            sections = []

        scripts = []
        skipped = 0
        seen = 0
        for section in sections:
            if not isinstance(section, dict):
                continue
            name = section.get("name")
            items = section.get("items")
            if not isinstance(name, str) or not name or not isinstance(items, list):
                continue
            for item in items:
                seen += 1
                title = item.get("title") if isinstance(item, dict) else None
                search = item.get("search") if isinstance(item, dict) else None
                if (not isinstance(item, dict)
                        or item.get("kind") != "text"
                        or not isinstance(search, str) or not search or len(search) >= COMMAND_MAX
                        or not isinstance(title, str) or not title):
                    skipped += 1
                    continue
                scripts.append({
                    "name": title,
                    "command": search,
                    "help": item.get("description") or "",
                    "id": _readily_id(name, title),
                    "source": "readily",
                    "readonly": True,
                })
        # `readily list --tag runbook` returns every note, each with its
        # #runbook-tagged items (own or inherited from the note's frontmatter).
        # Nothing tagged anywhere is a real answer worth a gentle nudge.
        warning = None if seen else "No #runbook items found in Readily"
        return {"scripts": scripts, "skipped": skipped, "warning": warning, "ok": True}
    except Exception as exc:
        return {"scripts": [], "skipped": 0, "warning": f"Readily error: {exc}", "ok": False}


def resolve_readily(script_id, environ, run):
    """The mapped Readily script for this id, or None. Used both by `run`
    (to resolve an id that isn't a native script) and by the scheduled
    .service path (which calls `runbook run <id>`)."""
    for script in read_readily_commands(environ, run)["scripts"]:
        if script["id"] == script_id:
            return script
    return None


def merge_readily(library, environ, run):
    """Append the config-gated Readily commands into `library` in place and
    return it, mirroring the merge the "list" command performs.

    Every command that returns a library to the UI runs this so the reply is
    always the full native+Readily view: the panel treats each reply as the
    whole list, so a native-only reply (from set-view/add/update/remove) would
    drop the Readily rows until the next `list`. Native scripts are already in
    `library["scripts"]`; this only adds the Readily rows. No-op when the
    toggle is off."""
    if not load_config(environ)["readily"]["enabled"]:
        return library
    readily = read_readily_commands(environ, run)
    schedules = load_readily_schedules(environ)
    for script in readily["scripts"]:
        sched = schedules.get(script["id"])
        if sched is not None:
            script["schedule"] = sched
        library["scripts"].append(script)
    if readily["warning"] is not None:
        library["readily_warning"] = readily["warning"]
    if readily["skipped"] > 0:
        library["readily_skipped"] = readily["skipped"]
    return library


# ------------------------------------------------------------------ schedule

def unit_dir(environ):
    base = environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "systemd", "user")


def runbook_bin_path():
    return os.path.join(PLUGIN_DIR, "bin", "runbook")


def _systemctl(run, environ, *args):
    return run(["systemctl", "--user", *args], env=environ,
               capture_output=True, text=True)


_BUS_UNAVAILABLE_MARKERS = ("bus", "not been booted", "failed to connect", "connection refused")


def _bus_unavailable(result):
    return result.returncode != 0 and any(
        marker in (result.stderr or "").lower() for marker in _BUS_UNAVAILABLE_MARKERS)


def _unit_base(sid):
    return "runbook-" + sid


def _unit_name(sid, ext):
    return _unit_base(sid) + ext


def normalize_calendar(expr, run):
    result = run(["systemd-analyze", "calendar", expr], capture_output=True, text=True)
    if result.returncode != 0:
        raise RunbookError("Not a valid schedule")
    for line in (result.stdout or "").splitlines():
        line = line.strip()
        if line.startswith("Normalized form:"):
            return line.split(":", 1)[1].strip()
    raise RunbookError("Not a valid schedule")


def render_service(script_id, environ):
    keep = ("RUNBOOK_TMUX_SOCKET", "RUNBOOK_TMUX_CONF", "XDG_CONFIG_HOME", "RUNBOOK_READILY_BIN")
    env_lines = "".join(
        f"Environment={k}={environ[k]}\n" for k in keep
        if environ.get(k) and "\n" not in environ[k])
    return (
        "[Unit]\n"
        f"Description=Runbook scheduled run of {script_id}\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"{env_lines}"
        f"ExecStart={runbook_bin_path()} run {script_id}\n")


def render_timer(schedule):
    if schedule["kind"] == "interval":
        s = schedule["seconds"]
        spec = f"OnBootSec={s}\nOnUnitActiveSec={s}\n"
    else:
        spec = f"OnCalendar={schedule['oncalendar']}\nPersistent=true\n"
    return ("[Unit]\n"
            "Description=Runbook schedule timer\n\n"
            "[Timer]\n"
            f"{spec}\n"
            "[Install]\n"
            "WantedBy=timers.target\n")


def sync_schedules(library, environ, run):
    directory = unit_dir(environ)
    os.makedirs(directory, exist_ok=True)
    scheduled = {s["id"]: s["schedule"] for s in library["scripts"] if s.get("schedule")}

    # Union in the Readily side-store, config-gated, with orphan cleanup:
    # a side id whose Readily command was renamed/deleted is pruned from the
    # store instead of being scheduled, so the stale-unit sweep below removes
    # its timer. When disabled, the store contributes nothing here (its
    # timers fall to the sweep too) and is left untouched -- it survives for
    # a later re-enable.
    side = load_readily_schedules(environ)
    if side and load_config(environ)["readily"]["enabled"]:
        readily = read_readily_commands(environ, run)
        if readily["ok"]:
            # A genuine read: an id no longer present is a real orphan
            # (renamed/deleted) -- prune it and let the stale sweep drop
            # its timer.
            readily_ids = {s["id"] for s in readily["scripts"]}
            orphaned = False
            for rid in list(side):
                if rid in readily_ids:
                    scheduled.setdefault(rid, side[rid])
                else:
                    del side[rid]
                    orphaned = True
            if orphaned:
                save_readily_schedules(environ, side)
        else:
            # Couldn't reach/read Readily (transient failure): we cannot
            # tell orphans from live ids, so do NOT prune or save the
            # store -- preserve the status quo by scheduling every side
            # entry as-is. A permanent removal is handled by the user
            # disabling the toggle, which tears everything down below.
            for rid, sched in side.items():
                scheduled.setdefault(rid, sched)

    warning = {"schedule_warning":
               "systemd user instance not available; the schedule is saved but not active"}

    if _bus_unavailable(_systemctl(run, environ, "daemon-reload")):
        return warning

    # Escribir/activar los programados.
    for sid, schedule in scheduled.items():
        base = os.path.join(directory, _unit_base(sid))
        _atomic_write(base + ".service", render_service(sid, environ))
        _atomic_write(base + ".timer", render_timer(schedule))
    if _bus_unavailable(_systemctl(run, environ, "daemon-reload")):
        return warning
    for sid in scheduled:
        if _bus_unavailable(_systemctl(run, environ, "enable", "--now", _unit_name(sid, ".timer"))):
            return warning

    # Quitar los que sobran.
    for name in os.listdir(directory):
        if not (name.startswith("runbook-") and name.endswith(".timer")):
            continue
        sid = name[len("runbook-"):-len(".timer")]
        if sid in scheduled:
            continue
        if _bus_unavailable(_systemctl(run, environ, "disable", "--now", name)):
            return warning
        for ext in (".timer", ".service"):
            try:
                os.unlink(os.path.join(directory, _unit_name(sid, ext)))
            except OSError:
                pass
    return {}


def _human_delay(seconds):
    s = int(seconds)
    if s < 60:
        return "in <1m"
    if s < 3600:
        return f"in {s // 60}m"
    if s < 86400:
        return f"in {s // 3600}h {(s % 3600) // 60}m"
    return f"in {s // 86400}d {(s % 86400) // 3600}h"


def _query_timer_next(sid, environ, run):
    """The report entry for one timer's next elapse, or None if it has no
    active timer / its properties are unusable. Shared by native and
    Readily-side ids alike."""
    result = _systemctl(run, environ, "show", _unit_name(sid, ".timer"),
                         "--property=NextElapseUSecRealtime",
                         "--property=NextElapseUSecMonotonic")
    if result.returncode != 0:
        return None
    try:
        values = dict(
            line.split("=", 1) for line in (result.stdout or "").splitlines() if "=" in line)
        realtime = int(values["NextElapseUSecRealtime"]) if "NextElapseUSecRealtime" in values else 0
        monotonic = int(values["NextElapseUSecMonotonic"]) if "NextElapseUSecMonotonic" in values else 0
    except ValueError:
        return None
    if realtime > 0:
        seconds_until = realtime / 1_000_000 - datetime.datetime.now(datetime.timezone.utc).timestamp()
    elif monotonic > 0:
        seconds_until = monotonic / 1_000_000 - time.clock_gettime(time.CLOCK_MONOTONIC)
    else:
        return None
    if seconds_until < 0:
        return None
    return {"next": _human_delay(seconds_until)}


def schedules_report(library, environ, run):
    try:
        ids = [s["id"] for s in library["scripts"] if s.get("schedule")]
        seen = set(ids)

        # Same config-gated union as sync_schedules, same ok-gating: a side
        # id only counts as pruned-by-absence when the read genuinely
        # succeeded. On a transient failure (ok: False) every side id is
        # still reported -- sync_schedules preserved its timer, so the
        # report must not silently drop it too.
        side = load_readily_schedules(environ)
        if side and load_config(environ)["readily"]["enabled"]:
            readily = read_readily_commands(environ, run)
            if readily["ok"]:
                readily_ids = {s["id"] for s in readily["scripts"]}
                candidates = (rid for rid in side if rid in readily_ids)
            else:
                candidates = iter(side)
            for rid in candidates:
                if rid not in seen:
                    ids.append(rid)
                    seen.add(rid)

        report = {}
        for sid in ids:
            entry = _query_timer_next(sid, environ, run)
            if entry is not None:
                report[sid] = entry
        return report
    except Exception:
        return {}


def _finalize_schedule(script, run):
    """Normalize a calendar schedule via systemd-analyze before it is saved;
    raises RunbookError if the expression is invalid."""
    sch = script.get("schedule")
    if sch and sch["kind"] == "calendar":
        sch["oncalendar"] = normalize_calendar(sch["oncalendar"], run)


def read_stdin_json(stdin):
    """One JSON object on one line. readline() (not read()) so the panel can
    keep the pipe open; the camera plugin's config.py does the same."""
    try:
        data = json.loads(stdin.readline() or "")
    except (ValueError, OSError):
        raise RunbookError("Expected a JSON object on stdin")
    if not isinstance(data, dict):
        raise RunbookError("Expected a JSON object on stdin")
    return data


def parse_size(args):
    cols, rows = DEFAULT_COLS, DEFAULT_ROWS
    it = iter(args)
    try:
        for flag in it:
            if flag == "--cols":
                cols = int(next(it))
            elif flag == "--rows":
                rows = int(next(it))
            else:
                raise RunbookError(f"Unknown option: {flag}")
    except (StopIteration, ValueError):
        raise RunbookError("--cols and --rows must be integers")
    return clamp_size(cols, rows)


def _script_id(args):
    if not args:
        raise RunbookError("Missing script id")
    return check_id(args[0])


def dispatch(argv, environ, run, stdin, kill, sleep, clock):
    if not argv:
        raise RunbookError(USAGE)
    command, args = argv[0], argv[1:]
    path = library_path(environ)

    if command == "list":
        return merge_readily(load_library(path), environ, run)
    if command == "add":
        fields = read_stdin_json(stdin)
        library = load_library(path)
        script = add_script(library, fields)
        _finalize_schedule(script, run)
        save_library(path, library)
        # sync runs on the native library; then merge the Readily rows into
        # the reply so the panel keeps them (it treats the reply as the list).
        report = sync_schedules(library, environ, run)
        return {**merge_readily(library, environ, run), **report}
    if command == "update":
        script_id = _script_id(args)
        fields = read_stdin_json(stdin)
        library = load_library(path)
        script = update_script(library, script_id, fields)
        _finalize_schedule(script, run)
        save_library(path, library)
        report = sync_schedules(library, environ, run)
        return {**merge_readily(library, environ, run), **report}
    if command == "remove":
        script_id = _script_id(args)
        library = load_library(path)
        remove_script(library, script_id)
        save_library(path, library)
        # The script is gone even if tmux is unavailable; the session is best effort.
        try:
            kill_session(build_tmux(environ, run), script_id)
        except RunbookError:
            pass
        report = sync_schedules(library, environ, run)
        return {**merge_readily(library, environ, run), **report}
    if command == "set-view":
        view = read_stdin_json(stdin)
        library = load_library(path)
        set_view(library, view)
        save_library(path, library)
        return merge_readily(library, environ, run)
    if command == "config":
        return load_config(environ)
    if command == "set-config":
        data = read_stdin_json(stdin)
        config = load_config(environ)
        incoming = data.get("readily")
        if isinstance(incoming, dict):
            config["readily"].update(incoming)
        config = _repair_config(config)
        save_config(environ, config)
        return {**config, **sync_schedules(load_library(path), environ, run)}
    if command == "schedule-set":
        sid = _script_id(args)
        try:
            raw = json.loads(stdin.readline() or "")
        except (ValueError, OSError):
            raise RunbookError("Expected a schedule object or null on stdin")
        schedule = validate_schedule(raw)
        if schedule and schedule["kind"] == "calendar":
            schedule["oncalendar"] = normalize_calendar(schedule["oncalendar"], run)
        store = load_readily_schedules(environ)
        if schedule is None:
            store.pop(sid, None)
        else:
            store[sid] = schedule
        save_readily_schedules(environ, store)
        return {"ok": True, **sync_schedules(load_library(path), environ, run)}
    if command == "schedules":
        return schedules_report(load_library(path), environ, run)

    tmux = build_tmux(environ, run)
    if command == "status":
        return {"sessions": list_sessions(tmux)}

    if command not in ("run", "screen", "send", "stop", "close", "resize"):
        raise RunbookError("Unknown command: " + command)

    script_id = _script_id(args)
    if command == "run":
        cols, rows = parse_size(args[1:])
        script = find_script(load_library(path), script_id)
        if script is None and load_config(environ)["readily"]["enabled"]:
            script = resolve_readily(script_id, environ, run)
        if script is None:
            raise RunbookError("No such script")
        try:
            state = session_state(tmux, script_id)
        except NoSession:
            state = None
        if state is not None and not state["dead"]:
            return {"ok": True, "already": True}
        if state is not None:
            kill_session(tmux, script_id)
        start_session(tmux, script_id, script["command"], cols, rows, environ)
        return {"ok": True, "already": False}
    if command == "screen":
        state = session_state(tmux, script_id)
        text = capture(tmux, script_id)
        return {"text": text, "dead": state["dead"], "exit": state["exit"], "prompt": detect_prompt(text)}
    if command == "send":
        data = read_stdin_json(stdin)
        if not isinstance(data.get("text"), str):
            raise RunbookError("Expected a \"text\" string")
        send_line(tmux, script_id, data["text"])
        return {"ok": True}
    if command == "stop":
        state = stop_session(tmux, script_id, kill=kill, sleep=sleep, clock=clock)
        return {"ok": True, "dead": state["dead"], "exit": state["exit"]}
    if command == "close":
        kill_session(tmux, script_id)
        return {"ok": True}
    if command == "resize":
        cols, rows = parse_size(args[1:])
        resize_session(tmux, script_id, cols, rows)
        return {"ok": True}


def main(argv=None, *, environ=None, run=subprocess.run, stdin=None, stdout=None,
         kill=os.kill, sleep=time.sleep, clock=time.monotonic):
    argv = sys.argv[1:] if argv is None else list(argv)
    environ = os.environ if environ is None else environ
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    try:
        payload = dispatch(argv, environ, run, stdin, kill, sleep, clock)
        code = 0
    except RunbookError as exc:
        payload = {"error": str(exc)}
        code = 1
    except OSError as exc:
        payload = {"error": "System error: " + str(exc)}
        code = 1
    stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    stdout.flush()
    return code


if __name__ == "__main__":
    sys.exit(main())
