#!/usr/bin/python3
"""Runbook engine: stores the user's scripts and drives a private tmux server.

Every subcommand prints one JSON document on stdout. Errors of our own print
{"error": "..."} and exit 1. Data from the panel arrives as one JSON line on
stdin; only ids and numbers travel as arguments.
"""
import json
import os
import re
import secrets
import signal
import subprocess
import sys
import tempfile
import time

USAGE = "Usage: runbook <command> [id] [--cols N --rows N]"


class RunbookError(Exception):
    """An error we report to the panel as {"error": message}."""


# ---------------------------------------------------------------- store

DEFAULT_VIEW = {"width": 960, "height": 540}
ID_RE = re.compile(r"^[0-9a-f]{32}$")
NAME_MAX, COMMAND_MAX, HELP_MAX = 64, 4096, 4096
VIEW_WIDTH, VIEW_HEIGHT = (600, 4000), (360, 3000)


def library_path(environ):
    base = environ.get("XDG_CONFIG_HOME") or os.path.join(
        environ.get("HOME") or os.path.expanduser("~"), ".config")
    return os.path.join(base, "runbook", "scripts.json")


def empty_library():
    return {"version": 1, "view": dict(DEFAULT_VIEW), "scripts": []}


def _has_control_chars(text):
    return any(ord(ch) < 32 or ord(ch) == 127 for ch in text)


def _text(fields, key, maximum, minimum, label):
    value = fields.get(key, "")
    if value is None:
        value = ""
    if not isinstance(value, str):
        raise RunbookError(f"{label} must be text")
    value = value.strip()
    if len(value) < minimum:
        raise RunbookError(f"{label} must be {minimum}-{maximum} characters")
    if len(value) > maximum:
        if minimum == 0:
            raise RunbookError(f"{label} must be at most {maximum} characters")
        raise RunbookError(f"{label} must be {minimum}-{maximum} characters")
    return value


def validate_script(fields):
    if not isinstance(fields, dict):
        raise RunbookError("Script must be a JSON object")
    name = _text(fields, "name", NAME_MAX, 1, "Name")
    if _has_control_chars(name):
        raise RunbookError("Name must not contain control characters")
    command = _text(fields, "command", COMMAND_MAX, 1, "Command")
    help_text = _text(fields, "help", HELP_MAX, 0, "Help")
    return {"name": name, "command": command, "help": help_text}


def _bounded_int(value, bounds, label):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise RunbookError(f"{label} must be a number")
    number = int(value)
    if not bounds[0] <= number <= bounds[1]:
        raise RunbookError(f"{label} must be between {bounds[0]} and {bounds[1]}")
    return number


def validate_view(view):
    if not isinstance(view, dict):
        raise RunbookError("View must be a JSON object")
    return {"width": _bounded_int(view.get("width"), VIEW_WIDTH, "Width"),
            "height": _bounded_int(view.get("height"), VIEW_HEIGHT, "Height")}


def _normalise(raw):
    library = empty_library()
    if not isinstance(raw, dict):
        return library
    try:
        library["view"] = validate_view(raw.get("view"))
    except RunbookError:
        pass
    for item in raw.get("scripts") or []:
        if not isinstance(item, dict) or not ID_RE.match(str(item.get("id", ""))):
            continue
        try:
            script = validate_script(item)
        except RunbookError:
            continue
        script["id"] = item["id"]
        library["scripts"].append(script)
    return library


def load_library(path):
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        return empty_library()
    except (OSError, UnicodeDecodeError) as exc:
        raise RunbookError(f"Cannot read scripts.json: {exc}")
    except json.JSONDecodeError:
        raise RunbookError("scripts.json is not valid JSON")
    return _normalise(raw)


def save_library(path, library):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    os.chmod(directory, 0o700)
    fd, tmp_path = tempfile.mkstemp(prefix=".scripts-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(library, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, path)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def new_id():
    return secrets.token_hex(16)


def find_script(library, script_id):
    for script in library["scripts"]:
        if script["id"] == script_id:
            return script
    return None


def _check_unique(library, name, skip_id=None):
    for script in library["scripts"]:
        if script["id"] != skip_id and script["name"].casefold() == name.casefold():
            raise RunbookError(f"A script named \"{name}\" already exists")


def add_script(library, fields):
    script = validate_script(fields)
    _check_unique(library, script["name"])
    script["id"] = new_id()
    library["scripts"].append(script)
    return script


def update_script(library, script_id, fields):
    current = find_script(library, script_id)
    if current is None:
        raise RunbookError("No such script")
    script = validate_script(fields)
    _check_unique(library, script["name"], skip_id=script_id)
    current.update(script)
    return current


def remove_script(library, script_id):
    current = find_script(library, script_id)
    if current is None:
        raise RunbookError("No such script")
    library["scripts"].remove(current)
    return current


def set_view(library, view):
    library["view"] = validate_view(view)
    return library["view"]


# ----------------------------------------------------------------- tmux

NO_SESSION_MESSAGE = "No session for this script"
NO_SESSION_MARKERS = ("no server running", "can't find", "no current target", "session not found", "error connecting to")
COLS_RANGE, ROWS_RANGE = (20, 500), (5, 200)
PROMPT_RE = re.compile(r"(password|contraseña)[^:]*:\s*$", re.IGNORECASE)
STATE_FORMAT = "#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}\t#{pane_pid}"
LIST_FORMAT = "#{session_name}\t#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}"
LAUNCHER = 'exec bash -c "$RUNBOOK_COMMAND"'


class NoSession(RunbookError):
    def __init__(self):
        super().__init__(NO_SESSION_MESSAGE)


class Tmux:
    """Every tmux call: fixed socket and config, bounded time, argv only."""

    def __init__(self, socket, conf, run=subprocess.run, timeout=5.0):
        self.socket = socket
        self.conf = conf
        self.run = run
        self.timeout = timeout

    def call(self, *args):
        argv = ["tmux", "-L", self.socket, "-f", self.conf, *args]
        try:
            proc = self.run(argv, capture_output=True, text=True, timeout=self.timeout, check=False)
        except subprocess.TimeoutExpired:
            raise RunbookError(f"tmux did not answer within {self.timeout:g} seconds")
        except OSError as exc:
            raise RunbookError(f"Cannot run tmux: {exc}")
        return proc.returncode, proc.stdout or "", proc.stderr or ""


def _missing(stderr):
    text = stderr.lower()
    return any(marker in text for marker in NO_SESSION_MARKERS)


def _fail(stderr):
    return RunbookError("tmux: " + (stderr.strip() or "unknown error"))


def check_id(script_id):
    if not isinstance(script_id, str) or not ID_RE.match(script_id):
        raise RunbookError("Invalid script id")
    return script_id


def clamp_size(cols, rows):
    return (min(max(int(cols), COLS_RANGE[0]), COLS_RANGE[1]),
            min(max(int(rows), ROWS_RANGE[0]), ROWS_RANGE[1]))


def path_with_local_bin(environ):
    home = environ.get("HOME") or os.path.expanduser("~")
    local = os.path.join(home, ".local", "bin")
    parts = [p for p in environ.get("PATH", "").split(":") if p]
    if local not in parts:
        parts.insert(0, local)
    return ":".join(parts)


def _exit_code(dead, status, sig):
    if not dead:
        return None
    if status.strip():
        return int(status)
    if sig.strip():
        return 128 + int(sig)
    return None


def list_sessions(tmux):
    code, out, err = tmux.call("list-sessions", "-F", LIST_FORMAT)
    if code != 0:
        if _missing(err):
            return {}
        raise _fail(err)
    sessions = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 4 or not ID_RE.match(parts[0]):
            continue
        dead = parts[1] == "1"
        sessions[parts[0]] = {"dead": dead, "exit": _exit_code(dead, parts[2], parts[3])}
    return sessions


def session_state(tmux, script_id):
    code, out, err = tmux.call("display", "-p", "-t", script_id, STATE_FORMAT)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)
    parts = out.strip("\n").split("\t")
    if len(parts) != 4 or parts[3].strip() == "":
        raise NoSession()
    dead = parts[0] == "1"
    return {"dead": dead, "exit": _exit_code(dead, parts[1], parts[2]), "pid": int(parts[3])}


def start_session(tmux, script_id, command, cols, rows, environ):
    home = environ.get("HOME") or os.path.expanduser("~")
    code, _, err = tmux.call(
        "new-session", "-d", "-s", script_id, "-x", str(cols), "-y", str(rows), "-c", home,
        "-e", "RUNBOOK_COMMAND=" + command,
        "-e", "PATH=" + path_with_local_bin(environ),
        "--", LAUNCHER)
    if code != 0:
        raise _fail(err)


def trim_trailing_blank(text):
    lines = text.split("\n")
    while lines and lines[-1].strip() == "":
        lines.pop()
    return "\n".join(lines)


def capture(tmux, script_id):
    code, out, err = tmux.call("capture-pane", "-p", "-t", script_id)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)
    return trim_trailing_blank(out)


def detect_prompt(text):
    for line in reversed(text.split("\n")):
        if line.strip():
            return "password" if PROMPT_RE.search(line) else None
    return None


def _checked(tmux, *args):
    code, _, err = tmux.call(*args)
    if code != 0:
        if _missing(err):
            raise NoSession()
        raise _fail(err)


def send_line(tmux, script_id, text):
    session_state(tmux, script_id)
    if text != "":
        _checked(tmux, "send-keys", "-t", script_id, "-l", "--", text)
    _checked(tmux, "send-keys", "-t", script_id, "Enter")


def resize_session(tmux, script_id, cols, rows):
    session_state(tmux, script_id)
    _checked(tmux, "resize-window", "-t", script_id, "-x", str(cols), "-y", str(rows))


def kill_session(tmux, script_id):
    tmux.call("kill-session", "-t", script_id)


# ----------------------------------------------------------------- stop


def _wait_dead(tmux, script_id, deadline, sleep, clock, poll):
    """Poll the pane until it is dead or the deadline passes. Returns the state."""
    while True:
        state = session_state(tmux, script_id)
        if state["dead"] or clock() >= deadline:
            return state
        sleep(poll)


def _signal_group(kill, pid, sig):
    try:
        kill(-pid, sig)
    except ProcessLookupError:
        pass


def stop_session(tmux, script_id, *, kill=os.kill, sleep=time.sleep, clock=time.monotonic,
                 grace=2.0, poll=0.1):
    """Interrupt the command but keep its screen: C-c, then SIGTERM and SIGKILL
    to the pane's process group (tmux starts the command as group leader, so
    the pgid equals pane_pid)."""
    state = session_state(tmux, script_id)
    if state["dead"]:
        return {"dead": True, "exit": state["exit"]}
    _checked(tmux, "send-keys", "-t", script_id, "C-c")
    state = _wait_dead(tmux, script_id, clock() + grace, sleep, clock, poll)
    if not state["dead"]:
        _signal_group(kill, state["pid"], signal.SIGTERM)
        state = _wait_dead(tmux, script_id, clock() + grace, sleep, clock, poll)
    if not state["dead"]:
        _signal_group(kill, state["pid"], signal.SIGKILL)
        state = _wait_dead(tmux, script_id, clock() + poll * 4, sleep, clock, poll)
    return {"dead": state["dead"], "exit": state["exit"]}


# ------------------------------------------------------------------ cli

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_COLS, DEFAULT_ROWS = 80, 24


def build_tmux(environ, run):
    socket = environ.get("RUNBOOK_TMUX_SOCKET") or "runbook"
    conf = environ.get("RUNBOOK_TMUX_CONF") or os.path.join(PLUGIN_DIR, "tmux.conf")
    return Tmux(socket, conf, run=run)


def read_stdin_json(stdin):
    """One JSON object on one line. readline() (not read()) so the panel can
    keep the pipe open; the camera plugin's config.py does the same."""
    try:
        data = json.loads(stdin.readline() or "")
    except (ValueError, OSError):
        raise RunbookError("Expected a JSON object on stdin")
    if not isinstance(data, dict):
        raise RunbookError("Expected a JSON object on stdin")
    return data


def parse_size(args):
    cols, rows = DEFAULT_COLS, DEFAULT_ROWS
    it = iter(args)
    try:
        for flag in it:
            if flag == "--cols":
                cols = int(next(it))
            elif flag == "--rows":
                rows = int(next(it))
            else:
                raise RunbookError(f"Unknown option: {flag}")
    except (StopIteration, ValueError):
        raise RunbookError("--cols and --rows must be integers")
    return clamp_size(cols, rows)


def _script_id(args):
    if not args:
        raise RunbookError("Missing script id")
    return check_id(args[0])


def dispatch(argv, environ, run, stdin, kill, sleep, clock):
    if not argv:
        raise RunbookError(USAGE)
    command, args = argv[0], argv[1:]
    path = library_path(environ)

    if command == "list":
        return load_library(path)
    if command == "add":
        fields = read_stdin_json(stdin)
        library = load_library(path)
        add_script(library, fields)
        save_library(path, library)
        return library
    if command == "update":
        script_id = _script_id(args)
        fields = read_stdin_json(stdin)
        library = load_library(path)
        update_script(library, script_id, fields)
        save_library(path, library)
        return library
    if command == "remove":
        script_id = _script_id(args)
        library = load_library(path)
        remove_script(library, script_id)
        save_library(path, library)
        # The script is gone even if tmux is unavailable; the session is best effort.
        try:
            kill_session(build_tmux(environ, run), script_id)
        except RunbookError:
            pass
        return library
    if command == "set-view":
        view = read_stdin_json(stdin)
        library = load_library(path)
        set_view(library, view)
        save_library(path, library)
        return library

    tmux = build_tmux(environ, run)
    if command == "status":
        return {"sessions": list_sessions(tmux)}

    if command not in ("run", "screen", "send", "stop", "close", "resize"):
        raise RunbookError("Unknown command: " + command)

    script_id = _script_id(args)
    if command == "run":
        cols, rows = parse_size(args[1:])
        script = find_script(load_library(path), script_id)
        if script is None:
            raise RunbookError("No such script")
        try:
            state = session_state(tmux, script_id)
        except NoSession:
            state = None
        if state is not None and not state["dead"]:
            return {"ok": True, "already": True}
        if state is not None:
            kill_session(tmux, script_id)
        start_session(tmux, script_id, script["command"], cols, rows, environ)
        return {"ok": True, "already": False}
    if command == "screen":
        state = session_state(tmux, script_id)
        text = capture(tmux, script_id)
        return {"text": text, "dead": state["dead"], "exit": state["exit"], "prompt": detect_prompt(text)}
    if command == "send":
        data = read_stdin_json(stdin)
        if not isinstance(data.get("text"), str):
            raise RunbookError("Expected a \"text\" string")
        send_line(tmux, script_id, data["text"])
        return {"ok": True}
    if command == "stop":
        state = stop_session(tmux, script_id, kill=kill, sleep=sleep, clock=clock)
        return {"ok": True, "dead": state["dead"], "exit": state["exit"]}
    if command == "close":
        kill_session(tmux, script_id)
        return {"ok": True}
    if command == "resize":
        cols, rows = parse_size(args[1:])
        resize_session(tmux, script_id, cols, rows)
        return {"ok": True}


def main(argv=None, *, environ=None, run=subprocess.run, stdin=None, stdout=None,
         kill=os.kill, sleep=time.sleep, clock=time.monotonic):
    argv = sys.argv[1:] if argv is None else list(argv)
    environ = os.environ if environ is None else environ
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    try:
        payload = dispatch(argv, environ, run, stdin, kill, sleep, clock)
        code = 0
    except RunbookError as exc:
        payload = {"error": str(exc)}
        code = 1
    stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    stdout.flush()
    return code


if __name__ == "__main__":
    sys.exit(main())
